{
  "name": "latch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "typecheck:packages": "turbo run typecheck --filter=./packages/*",
    "build": "turbo run build --filter=./packages/*",
    "test": "turbo run test --filter=./packages/*",
    "verify:publish": "node scripts/verify-publish.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm typecheck:packages && pnpm test && pnpm build && pnpm verify:publish && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@napi-rs/lzma": "1.4.5",
      "@hono/node-server@<1.19.15": "1.19.15",
      "@hono/node-server@>=2.0.0 <2.0.10": "2.0.10",
      "@modelcontextprotocol/sdk@<1.31.0": "1.31.0",
      "@vitest/mocker@<4.1.11": "4.1.11",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "fast-uri@<3.1.8": "3.1.8",
      "hono@<4.13.7": "4.13.7",
      "ip-address@<10.7.1": "10.7.1",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "shell-quote@<1.11.0": "1.11.0",
      "source-map-js@<1.2.2": "1.2.2",
      "vitest@<4.1.11": "4.1.11"
    }
  }
}
