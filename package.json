{
  "name": "latch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "edge": "pnpm --silent --filter latch-platform edge",
    "edge:setup": "pnpm --silent --filter latch-platform edge:setup",
    "edge:run": "pnpm --silent --filter latch-platform edge:run",
    "edge:judge": "pnpm --silent --filter latch-platform edge:judge",
    "edge:judge:pairwise": "pnpm --silent --filter latch-platform edge:judge:pairwise",
    "edge:reliability": "pnpm --silent --filter latch-platform edge:reliability",
    "edge:report": "pnpm --silent --filter latch-platform edge:report",
    "edge:review:export": "pnpm --silent --filter latch-platform edge:review:export",
    "edge:review:import": "pnpm --silent --filter latch-platform edge:review:import",
    "edge:snapshot": "pnpm --silent --filter latch-platform edge:snapshot",
    "edge:snapshot:kn": "pnpm --silent --filter latch-platform edge:snapshot:kn",
    "edge:version": "pnpm --silent --filter latch-platform edge:version",
    "typecheck": "turbo run typecheck",
    "typecheck:packages": "turbo run typecheck --filter=./packages/*",
    "build": "turbo run build --filter=./packages/*",
    "test": "turbo run test --filter=./packages/*",
    "verify:publish": "node scripts/verify-publish.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm typecheck:packages && pnpm test && pnpm build && pnpm verify:publish && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "@napi-rs/lzma": "1.4.5"
    }
  }
}
