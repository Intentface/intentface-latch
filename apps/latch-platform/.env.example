# Shared libsql/sqlite DB (better-auth + Latch in dev). file: is relative to apps/latch-platform.
DATABASE_URL=file:./latch.db
# better-auth signing secret (generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# Models (for running agents)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Vault master key (base64 32 bytes)
LATCH_VAULT_KEY=
