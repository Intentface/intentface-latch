# Shared libsql/sqlite DB (better-auth + Latch in dev). file: is relative to apps/latch-platform.
DATABASE_URL=file:./latch.db
# better-auth signing secret (generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=
# Models (for running agents)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Vault master key (base64 32 bytes)
LATCH_VAULT_KEY=

# Loredex MCP server URL (the knowledge-base workspace endpoint)
LOREDEX_MCP_URL=https://app.loredex.ai/ws_.../mcp

# Langfuse observability (optional — absent keys disable tracing entirely).
# Every agent run becomes a trace; attached-eval judge verdicts and user
# feedback land on it as scores, shown on /observability.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Google Workspace OAuth client, shared by two connections: google_workspace
# (mirage sandbox read-only mounts: /gdrive /gmail /gdocs /gsheets /gslides)
# and google_workspace_write (approval-gated gmail_send tool; separate grant).
# A "Web application" client in Google Cloud Console with BOTH redirect URIs
#   <PUBLIC_BASE_URL>/api/latch/connections/google_workspace/callback
#   <PUBLIC_BASE_URL>/api/latch/connections/google_workspace_write/callback
# APIs to enable: Drive, Gmail, Docs, Sheets, Slides. Scopes: the five
# *.readonly ones plus gmail.send, documents, spreadsheets, presentations
# (external apps list them on the consent screen; internal/testing apps just
# need the APIs enabled).
# Separate from the Google login and Calendar clients. Unset → connections off.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Development only: let user-added MCP connections reach a server on this
# machine (localhost, 127.0.0.1, [::1]) — a local MCP server. Other private
# addresses stay blocked. Ignored in production.
# LATCH_ALLOW_LOCALHOST_MCP=1
