# Slack app: create it from slack-manifest.json (set request_url to https://<your tunnel>/slack/events).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# A model key the catalog knows (any one of these).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Channels are not configured: the bot watches every channel it is a member of. /invite to start, /kick to stop.

# Optional
# AMBIENT_MODEL=claude-sonnet-4-6
# AMBIENT_QUIET_MS=90000          # a tick runs this long after the last event (a mention runs at once)
# AMBIENT_HEARTBEAT_MS=3600000    # quiet-channel check for overdue items; 0 disables
# AMBIENT_TRIAGE_MODEL=           # a cheap catalog model that decides whether a batch is worth waking the agent; empty = rules only
# AMBIENT_MAX_DEFER_MS=1800000    # deferred events are read regardless after this long
# AMBIENT_COMPACT_AFTER=80        # compact the monologue at this many messages
# AMBIENT_MAX_POSTS_PER_DAY=5
# AMBIENT_TOKENS_PER_DAY=500000
# AMBIENT_STATE=sqlite            # or `canvas`: the document lives in the channel canvas, humans can edit it
# AMBIENT_ADMIN_TOKEN=            # protects /channels/* when set
# AMBIENT_DB=file:./ambient.db
# PORT=8790
