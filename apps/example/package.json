  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx --conditions development src/runtime.smoke.ts",
    "smoke:server": "tsx --conditions development src/server.smoke.ts",
    "smoke:tools": "tsx --conditions development src/tools.smoke.ts",
    "smoke:durability": "tsx --conditions development src/durability.smoke.ts",
    "smoke:resume": "tsx --conditions development src/resume.smoke.ts",
    "smoke:checkpoint": "tsx --conditions development src/checkpoint.smoke.ts",
    "serve": "tsx --conditions development --env-file=.env src/serve.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.73",
    "@hono/node-server": "^2.0.5",
    "@intentface/latch-core": "workspace:*",
    "@intentface/latch-drizzle": "workspace:*",
    "@intentface/latch-server": "workspace:*",
    "@libsql/client": "^0.15.0",
    "ai": "7.0.0-beta.178",
    "hono": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
