# Copy this file to `.env` (same folder) and fill in real keys.
# `.env` is gitignored — never commit real keys.

# Direct provider keys (read automatically by the @ai-sdk/* packages):
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Vault master key — base64 of 32 random bytes. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
LATCH_VAULT_KEY=

# Optional: serve.ts port (default 8787)
PORT=8787

# Optional MCP OAuth demo (the redirect routes live in the API — see serve.ts).
# Set to a real OAuth-protected MCP server to enable /connections/demo/authorize.
# MCP_OAUTH_SERVER_URL=https://mcp.example.com/mcp
# PUBLIC_BASE_URL=https://your-app.example.com
# OAUTH_SUCCESS_URL=https://your-app.example.com/connected
# MCP_OAUTH_AUTH_SERVERS=https://auth.example.com   # comma-separated allowlist
