{
  "name": "@intentface/latch-core",
  "version": "0.0.0",
  "description": "Latch core — runtime, types, and seams for building agents on the AI SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.0-beta.178"
  },
  "devDependencies": {
    "ai": "7.0.0-beta.178",
    "typescript": "^5.7.0"
  }
}
