{
  "name": "@intentface/latch-core",
  "version": "0.13.2",
  "description": "Latch core — runtime, types, and seams for building agents on the AI SDK. Subpaths: /models (models.dev catalog + provider hooks) and /harness (default sandbox/app tools); their extra deps are optional peers, loaded lazily.",
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "llm",
    "agent-runtime",
    "durable-execution",
    "tool-calling"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "development": "./src/vault-node.ts",
      "types": "./dist/vault-node.d.ts",
      "import": "./dist/vault-node.js"
    },
    "./models": {
      "development": "./src/models/index.ts",
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./harness": {
      "development": "./src/harness/index.ts",
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/vault-node.d.ts",
        "import": "./dist/vault-node.js"
      },
      "./models": {
        "types": "./dist/models/index.d.ts",
        "import": "./dist/models/index.js"
      },
      "./harness": {
        "types": "./dist/harness/index.d.ts",
        "import": "./dist/harness/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=4.0.0",
    "@ai-sdk/google": ">=4.0.0",
    "@ai-sdk/openai": ">=4.0.0",
    "ai": ">=7.0.0",
    "turndown": ">=7.0.0",
    "@intentface/latch-net": "workspace:^"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.57",
    "@ai-sdk/google": "^4.0.75",
    "@ai-sdk/openai": "^4.0.70",
    "@intentface/latch-net": "workspace:^",
    "@types/node": "^22",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.106",
    "turndown": "^7.2.4",
    "typescript": "^5.7.0",
    "vitest": "^4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-latch.git",
    "directory": "packages/core"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "turndown": {
      "optional": true
    },
    "@intentface/latch-net": {
      "optional": true
    }
  }
}
