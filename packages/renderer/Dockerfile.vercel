# Slim base + Chromium only. The official Playwright image has a ~2 GB layer
# (all three browsers + deps) that exceeds Vercel Container Registry's
# per-layer upload limit (413) — so install just Chromium, in separate layers.
FROM node:22-slim

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY package.json ./
RUN npm install
# System libraries Chromium needs, then the browser itself (two smaller layers).
RUN npx playwright install-deps chromium && rm -rf /var/lib/apt/lists/*
# Headless-only service: the chromium headless shell alone is ~half the size.
RUN npx playwright install --only-shell chromium
# Compile TypeScript, then drop dev deps (typescript, @types/node) from the image.
COPY tsconfig.json ./
COPY src ./src
RUN npx tsc -p tsconfig.json && npm prune --omit=dev

# Drop root: the service renders untrusted pages, so run as the base image's
# unprivileged `node` user. Make the app + browser files readable by it first.
RUN chown -R node:node /app /ms-playwright
USER node

# Vercel routes traffic to $PORT (default 80).
CMD ["node", "dist/server.js"]
