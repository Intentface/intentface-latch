{
  "name": "@intentface/latch-langfuse",
  "version": "0.13.2",
  "description": "Latch observability on Langfuse — one-line tracing for latch runtimes via the AI SDK telemetry integration, plus score and trace-read helpers for platforms.",
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "llm",
    "langfuse",
    "opentelemetry",
    "observability"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:^",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@langfuse/vercel-ai-sdk": "^5.11.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ai": "^7.0.106",
    "typescript": "^5.7.0",
    "vitest": "^4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-latch.git",
    "directory": "packages/langfuse"
  }
}
