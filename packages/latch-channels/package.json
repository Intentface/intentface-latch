{
  "name": "@intentface/latch-channels",
  "version": "0.17.1",
  "description": "Latch channels — bring a Latch agent to chat platforms (Slack first). A generic run→render-event projection plus per-platform adapters, reusing the core runtime, storage and durability (no separate state store).",
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "llm",
    "slack",
    "telegram",
    "whatsapp",
    "chatbot"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./slack": {
      "development": "./src/slack/index.ts",
      "types": "./dist/slack/index.d.ts",
      "import": "./dist/slack/index.js"
    },
    "./telegram": {
      "development": "./src/telegram/index.ts",
      "types": "./dist/telegram/index.d.ts",
      "import": "./dist/telegram/index.js"
    },
    "./whatsapp": {
      "development": "./src/whatsapp/index.ts",
      "types": "./dist/whatsapp/index.d.ts",
      "import": "./dist/whatsapp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./slack": {
        "types": "./dist/slack/index.d.ts",
        "import": "./dist/slack/index.js"
      },
      "./telegram": {
        "types": "./dist/telegram/index.d.ts",
        "import": "./dist/telegram/index.js"
      },
      "./whatsapp": {
        "types": "./dist/whatsapp/index.d.ts",
        "import": "./dist/whatsapp/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:^"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ai": "^7.0.106",
    "typescript": "^5.7.0",
    "vitest": "^4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-latch.git",
    "directory": "packages/latch-channels"
  }
}
