{
  "name": "@intentface/latch-agent-builder",
  "version": "0.22.1",
  "description": "Latch agent builder — the meta-agent that designs, creates, and updates agents from a conversation. Host-agnostic core with an extension seam (evals, tool authoring) so hosts plug in what they support.",
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "llm",
    "agent-builder",
    "prompt-management"
  ],
  "license": "Apache-2.0",
  "homepage": "https://intentface-latch-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Intentface/intentface-latch/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./record": {
      "development": "./src/record.ts",
      "types": "./dist/record.d.ts",
      "import": "./dist/record.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./record": {
        "types": "./dist/record.d.ts",
        "import": "./dist/record.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:^",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ai": "^7.0.106",
    "typescript": "^5.7.0",
    "vitest": "^4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-latch.git",
    "directory": "packages/agent-builder"
  }
}
