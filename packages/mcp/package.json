{
  "name": "@intentface/latch-mcp",
  "version": "0.22.0",
  "description": "Latch MCP host — connect to MCP servers as tools, with a per-tenant SSRF allowlist and vault-brokered auth.",
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "llm",
    "mcp",
    "model-context-protocol",
    "tools"
  ],
  "license": "Apache-2.0",
  "homepage": "https://intentface-latch-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Intentface/intentface-latch/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:^",
    "@intentface/latch-net": "workspace:^"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": ">=2.0.0",
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.53",
    "ai": "^7.0.106",
    "typescript": "^5.7.0",
    "vitest": "^4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-latch.git",
    "directory": "packages/mcp"
  }
}
