{
  "name": "@intentface/latch-memory",
  "version": "0.0.0",
  "description": "Latch agent memory — always-loaded compiled index, searchable episodic store, and background extraction/consolidation over a pluggable MemoryStore (Loredex-backed first).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:memory-search": "tsx evals/run.ts",
    "eval:regen-fixtures": "tsx evals/generate.ts"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ai": "^7.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4"
  }
}
