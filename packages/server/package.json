{
  "name": "@intentface/latch-server",
  "version": "0.0.0",
  "description": "Hono routes for Latch — mount into your app (embed) or run standalone.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=7.0.0-beta.178",
    "hono": ">=4"
  },
  "devDependencies": {
    "ai": "7.0.0-beta.178",
    "hono": "^4.6.0",
    "typescript": "^5.7.0"
  }
}
