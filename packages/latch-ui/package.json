{
  "name": "@intentface/latch-ui",
  "version": "0.0.0",
  "description": "Latch UI — chat components, theme, and primitives (base-ui + Tailwind v4), ported from intentface-chat.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-document": "^3.19.0",
    "@tiptap/extension-paragraph": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-text": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.31.1",
    "nanoid": "^5.1.11",
    "react-colorful": "^5.7.0",
    "streamdown": "^2.2.0",
    "tailwind-merge": "^3.4.0",
    "use-stick-to-bottom": "^1.1.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "@ai-sdk/react": ">=4.0.0",
    "@base-ui/react": ">=1.2.0",
    "ai": ">=7.0.0",
    "lucide-react": ">=0.5.0",
    "next-themes": ">=0.4.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.2",
    "@base-ui/react": "^1.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai": "^7.0.2",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.0"
  }
}
