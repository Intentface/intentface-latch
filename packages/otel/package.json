{
  "name": "@intentface/latch-otel",
  "version": "0.22.1",
  "description": "Latch tracing over OpenTelemetry — one trace per run, the AI SDK's GenAI spans under it, sent over OTLP to any backend, with a ready preset for Langfuse.",
  "keywords": [
    "ai",
    "ai-sdk",
    "agents",
    "llm",
    "opentelemetry",
    "otlp",
    "observability",
    "langfuse"
  ],
  "license": "Apache-2.0",
  "homepage": "https://intentface-latch-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Intentface/intentface-latch/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langfuse": {
      "development": "./src/langfuse.ts",
      "types": "./dist/langfuse.d.ts",
      "import": "./dist/langfuse.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./langfuse": {
        "types": "./dist/langfuse.d.ts",
        "import": "./dist/langfuse.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intentface/latch-core": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "peerDependencies": {
    "@ai-sdk/otel": ">=1.0.0",
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/otel": "1.0.106",
    "@intentface/latch-drizzle": "workspace:^",
    "@libsql/client": "^0.15.0",
    "@types/node": "^22",
    "ai": "^7.0.106",
    "drizzle-orm": "^0.45.0",
    "typescript": "^5.7.0",
    "vitest": "^4",
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-latch.git",
    "directory": "packages/otel"
  }
}
